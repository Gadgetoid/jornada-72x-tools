set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

get_filename_component(JORNADA_TOOLCHAIN_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

set(JORNADA_CE_VERSION 3 CACHE STRING "Windows CE version to target")
set_property(CACHE JORNADA_CE_VERSION PROPERTY STRINGS 3)
set(JORNADA_WIN32_WCE ${JORNADA_CE_VERSION}00)
set(JORNADA_TARGET armv4-unknown-none-wince)
set(JORNADA_TARGET_FLAGS "-mcpu=strongarm -marm -mfloat-abi=soft -fno-pic -fno-unwind-tables -fno-asynchronous-unwind-tables")
set(JORNADA_ARCH_DEFINES ARM _ARM_ ARMV4)

if(NOT JORNADA_LLVM_ROOT)
    set(JORNADA_LLVM_ROOT "$ENV{JORNADA_LLVM_ROOT}")
endif()
if(NOT JORNADA_LLVM_ROOT AND EXISTS "${JORNADA_TOOLCHAIN_ROOT}/llvm/bin/clang")
    set(JORNADA_LLVM_ROOT "${JORNADA_TOOLCHAIN_ROOT}/llvm")
endif()
if(NOT JORNADA_LLVM_ROOT)
    message(FATAL_ERROR "Set JORNADA_LLVM_ROOT, or link ${JORNADA_TOOLCHAIN_ROOT}/llvm, to an LLVM install with the armv4-unknown-none-wince target")
endif()
set(JORNADA_LLVM_ROOT "${JORNADA_LLVM_ROOT}" CACHE PATH "LLVM install with the armv4-unknown-none-wince target")

find_program(JORNADA_LLD ld.lld HINTS "${JORNADA_LLVM_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)

set(CMAKE_C_COMPILER "${JORNADA_LLVM_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${JORNADA_LLVM_ROOT}/bin/clang++")
set(CMAKE_ASM_COMPILER "${JORNADA_LLVM_ROOT}/bin/clang")
set(CMAKE_AR "${JORNADA_LLVM_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${JORNADA_LLVM_ROOT}/bin/llvm-ranlib")
set(CMAKE_LINKER "${JORNADA_LLD}")
set(CMAKE_C_COMPILER_TARGET ${JORNADA_TARGET})
set(CMAKE_CXX_COMPILER_TARGET ${JORNADA_TARGET})
set(CMAKE_ASM_COMPILER_TARGET ${JORNADA_TARGET})
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES JORNADA_LLVM_ROOT)

set(CMAKE_C_FLAGS_INIT "${JORNADA_TARGET_FLAGS} -fshort-wchar -ffreestanding -nostdlibinc -ffunction-sections -fdata-sections -D_WIN32_WCE=${JORNADA_WIN32_WCE}")
foreach(define IN LISTS JORNADA_ARCH_DEFINES)
    string(APPEND CMAKE_C_FLAGS_INIT " -D${define}")
endforeach()
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -std=c++20 -fno-exceptions -fno-rtti -fno-threadsafe-statics")
if(EXISTS "${JORNADA_LLVM_ROOT}/include/c++/v1/__config" AND EXISTS "${JORNADA_LLVM_ROOT}/share/libcxx/src/string.cpp")
    set(JORNADA_LIBCXX ON)
    string(APPEND CMAKE_CXX_FLAGS_INIT " -nostdinc++")
else()
    set(JORNADA_LIBCXX OFF)
endif()
set(CMAKE_ASM_FLAGS_INIT "${JORNADA_TARGET_FLAGS}")
set(CMAKE_BUILD_TYPE_INIT MinSizeRel)
set(CMAKE_C_FLAGS_RELEASE_INIT "-Os -fomit-frame-pointer")
set(CMAKE_C_FLAGS_MINSIZEREL_INIT "-Os -fomit-frame-pointer")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "-Os -fomit-frame-pointer")
set(CMAKE_CXX_FLAGS_MINSIZEREL_INIT "-Os -fomit-frame-pointer")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static --emit-relocs --gc-sections")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <CMAKE_C_LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <CMAKE_CXX_LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

list(APPEND CMAKE_MODULE_PATH "${JORNADA_TOOLCHAIN_ROOT}/cmake")
