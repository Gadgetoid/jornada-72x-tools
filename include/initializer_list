#ifndef JORNADA_INITIALIZER_LIST
#define JORNADA_INITIALIZER_LIST

#include <stddef.h>

namespace std {

template <typename T>
class initializer_list {
public:
    using value_type = T;
    using reference = const T &;
    using const_reference = const T &;
    using size_type = size_t;
    using iterator = const T *;
    using const_iterator = const T *;

    constexpr initializer_list() noexcept : first(nullptr), count(0) {}

    constexpr size_t size() const noexcept {
        return count;
    }

    constexpr const T *begin() const noexcept {
        return first;
    }

    constexpr const T *end() const noexcept {
        return first + count;
    }

private:
    constexpr initializer_list(const T *first, size_t count) noexcept : first(first), count(count) {}

    const T *first;
    size_t count;
};

template <typename T>
constexpr const T *begin(initializer_list<T> list) noexcept {
    return list.begin();
}

template <typename T>
constexpr const T *end(initializer_list<T> list) noexcept {
    return list.end();
}

}

#endif
