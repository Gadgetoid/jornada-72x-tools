#!/usr/bin/env python3
import argparse
import socket
import struct
import threading

DESKTOP_PORT = 5679
PING = 0x12345678
PACKET_MAX = 512
PING_SECONDS = 1
IP_FREEBIND = getattr(socket, "IP_FREEBIND", 15)


def describe(packet):
    name_offset = struct.unpack_from("<I", packet, 0x18)[0] if len(packet) >= 0x1C else len(packet)
    name = packet[name_offset:].decode("utf-16-le", "replace").split("\0")[0]
    version = struct.unpack_from("<H", packet, 4)[0] if len(packet) >= 6 else 0
    return "%s, Windows CE %d.x" % (name, version)


def serve(connection, address):
    print("jornada-desktop: connection from %s" % address[0], flush=True)
    received = b""
    pinging = False
    connection.settimeout(PING_SECONDS)
    while True:
        try:
            data = connection.recv(4096)
            if not data:
                break
            received += data
        except socket.timeout:
            pass
        except OSError:
            break
        while len(received) >= 4:
            length = struct.unpack_from("<I", received)[0]
            if length in (0, PING):
                received = received[4:]
                continue
            if length >= PACKET_MAX:
                print("jornada-desktop: the device asked for a password, which isn't supported", flush=True)
                received = b""
                break
            if len(received) < 4 + length:
                break
            print("jornada-desktop: %s" % describe(received[4:4 + length]), flush=True)
            received = received[4 + length:]
            pinging = True
        if pinging:
            try:
                connection.sendall(struct.pack("<I", PING))
            except OSError:
                break
    print("jornada-desktop: %s went away" % address[0], flush=True)
    connection.close()


def main():
    parser = argparse.ArgumentParser(description="Answer a Windows CE device's desktop connection, so PC Link stays connected")
    parser.add_argument("--address", default="0.0.0.0", help="address to listen on; it needn't exist yet")
    arguments = parser.parse_args()
    listener = socket.socket()
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.setsockopt(socket.SOL_IP, IP_FREEBIND, 1)
    listener.bind((arguments.address, DESKTOP_PORT))
    listener.listen(4)
    print("jornada-desktop: listening on %s port %d" % (arguments.address, DESKTOP_PORT), flush=True)
    while True:
        connection, address = listener.accept()
        threading.Thread(target=serve, args=(connection, address), daemon=True).start()


if __name__ == "__main__":
    main()
