#!/usr/bin/env python3
import os
import select
import sys
import time

HANDSHAKE_SECONDS = 20
GREETING = b"CLIENT"
ANSWER = b"CLIENTSERVER"
PPP_FLAG = b"~"


def main():
    deadline = time.time() + HANDSHAKE_SECONDS
    received = b""
    while time.time() < deadline:
        ready, _, _ = select.select([0], [], [], 0.5)
        if not ready:
            continue
        data = os.read(0, 4096)
        if not data:
            sys.exit("jornada-handshake: the device hung up")
        received += data
        while GREETING in received:
            received = received.split(GREETING, 1)[1]
            os.write(1, ANSWER)
        if PPP_FLAG in received:
            sys.exit(0)
    sys.exit("jornada-handshake: no PPP from the device")


if __name__ == "__main__":
    main()
