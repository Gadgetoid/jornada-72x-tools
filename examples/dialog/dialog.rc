#include <windows.h>
#include "resource.h"

IDD_NAME DIALOG 0, 0, 160, 58
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "Tahoma"
BEGIN
    LTEXT "&Your name:", IDC_STATIC, 6, 8, 50, 10
    EDITTEXT IDC_NAME, 58, 6, 96, 13, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 52, 36, 48, 15, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 106, 36, 48, 15, WS_TABSTOP
END

STRINGTABLE
BEGIN
    IDS_TITLE "Dialog"
    IDS_GREETING "Hello, %s!"
END
