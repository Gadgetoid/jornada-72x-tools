{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "/*", "close": " */", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["<", ">"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?:[Bb][Ee][Gg][Ii][Nn]\\b|.*\\{\\s*(?://.*)?$)",
        "decreaseIndentPattern": "^\\s*(?:[Ee][Nn][Dd]\\b|\\})"
    },
    "folding": {
        "markers": {
            "start": "^\\s*(?:[Bb][Ee][Gg][Ii][Nn]\\b|.*\\{\\s*(?://.*)?$)",
            "end": "^\\s*(?:[Ee][Nn][Dd]\\b|\\})"
        }
    }
}
