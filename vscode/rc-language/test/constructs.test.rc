// Version information
VS_VERSION_INFO VERSIONINFO
// <--------------- support.constant.version.rc
//              ^^^^^^^^^^^ storage.type.resource.rc
 FILEVERSION 1,0,0,1
// <~----------- keyword.other.versioninfo.rc
 PRODUCTVERSION 1,0,0,1
// <~-------------- keyword.other.versioninfo.rc
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
// <~------------- keyword.other.versioninfo.rc
//             ^^^^^^^^^^^^^^^^^^^^ support.constant.version.rc
 FILEFLAGS 0x0L
// <~--------- keyword.other.versioninfo.rc
//         ^^^^ constant.numeric.hex.rc
 FILEOS VOS_WINDOWSCE
// <~------ keyword.other.versioninfo.rc
//      ^^^^^^^^^^^^^ support.constant.version.rc
 FILETYPE VFT_APP
// <~-------- keyword.other.versioninfo.rc
 FILESUBTYPE VFT2_UNKNOWN
// <~----------- keyword.other.versioninfo.rc
//           ^^^^^^^^^^^^ support.constant.version.rc
BEGIN
// <----- keyword.control.block.begin.rc
    BLOCK "StringFileInfo"
//  ^^^^^ keyword.other.versioninfo.rc
    BEGIN
//  ^^^^^ keyword.control.block.begin.rc
        VALUE "FileDescription", "App\0"
//      ^^^^^ keyword.other.versioninfo.rc
//                                   ^^ constant.character.escape.rc
        VALUE "Translation", 0x409, 1200
//                           ^^^^^ constant.numeric.hex.rc
    END
//  ^^^ keyword.control.block.end.rc
END
