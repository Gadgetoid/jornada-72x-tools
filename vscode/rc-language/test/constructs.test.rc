// Strings and numbers
    "a ""quoted"" word\tand\n\\ \x41 \101", 1, 0x1F, 65535L, 0xFFL, 3
//  ^ string.quoted.double.rc punctuation.definition.string.begin.rc
//     ^^ string.quoted.double.rc constant.character.escape.quote.rc
//             ^^ string.quoted.double.rc constant.character.escape.quote.rc
//                    ^^ string.quoted.double.rc constant.character.escape.rc
//                         ^^ constant.character.escape.rc
//                           ^^ constant.character.escape.rc
//                              ^^^^ constant.character.escape.rc
//                                   ^^^^ constant.character.escape.rc
//                                       ^ string.quoted.double.rc punctuation.definition.string.end.rc
//                                        ^ punctuation.separator.comma.rc - string.quoted.double.include.rc string.quoted.double.rc string.quoted.double.wide.rc string.quoted.other.lt-gt.include.rc string.unquoted.rc
//                                          ^ constant.numeric.decimal.rc - string.quoted.double.rc
//                                             ^^^^ constant.numeric.hex.rc
//                                                   ^^^^^^ constant.numeric.decimal.rc
//                                                           ^^^^^ constant.numeric.hex.rc
//                                                      ^ constant.numeric.decimal.rc
    "", L"wide ""q""", """", END
//  ^^ string.quoted.double.rc
//      ^ string.quoted.double.wide.rc storage.type.string.rc
//             ^^ string.quoted.double.wide.rc constant.character.escape.quote.rc
//                     ^^^^ string.quoted.double.rc
//                           ^^^ keyword.control.block.end.rc - string.quoted.double.include.rc string.quoted.double.rc string.quoted.double.wide.rc string.quoted.other.lt-gt.include.rc string.unquoted.rc
    LTEXT "continued \
//         ^^^^^^^^^ string.quoted.double.rc
//                   ^ string.quoted.double.rc constant.character.escape.line-continuation.rc
           across lines", -1, 1, 2, 3, 4
//         ^^^^^^ string.quoted.double.rc
//                     ^ string.quoted.double.rc punctuation.definition.string.end.rc
//                         ^ constant.numeric.decimal.rc - string.quoted.double.rc
    "unterminated, BEGIN
//                 ^^^^^ string.quoted.double.rc
END
// <--- keyword.control.block.end.rc - string.quoted.double.include.rc string.quoted.double.rc string.quoted.double.wide.rc string.quoted.other.lt-gt.include.rc string.unquoted.rc

