#!/usr/bin/env python3
import argparse
import json
import os
import re
import shutil
import struct
import subprocess
import sys

IMAGE_BASE = 0x10000
SLOT_SIZE = 0x02000000
SLOTS_END = 0x42000000
SHF_EXECINSTR = 0x4
ADDRESS = re.compile(r"\b(?:0x)?([0-9a-fA-F]{8})\b")


def find_symbolizer():
    root = os.environ.get("JORNADA_LLVM_ROOT")
    if root:
        return os.path.join(root, "bin", "llvm-symbolizer")
    bundled = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "llvm", "bin", "llvm-symbolizer")
    if os.path.exists(bundled):
        return bundled
    found = shutil.which("llvm-symbolizer")
    if found:
        return found
    try:
        prefix = subprocess.run(["brew", "--prefix", "llvm"], capture_output=True, text=True, check=True).stdout.strip()
        return os.path.join(prefix, "bin", "llvm-symbolizer")
    except (OSError, subprocess.CalledProcessError):
        sys.exit("llvm-symbolizer not found: set JORNADA_LLVM_ROOT or put it on PATH")


def code_ranges(elf_path):
    data = open(elf_path, "rb").read()
    section_offset = struct.unpack_from("<I", data, 0x20)[0]
    entry_size, count = struct.unpack_from("<HH", data, 0x2E)
    ranges = []
    for index in range(count):
        _, _, flags, address, _, size = struct.unpack_from("<IIIIII", data, section_offset + entry_size * index)
        if flags & SHF_EXECINSTR and size:
            ranges.append((address, address + size))
    return ranges


class Module:
    def __init__(self, specification):
        path, _, load_address = specification.partition("@")
        self.path = path[:-4] + ".elf" if path.lower().endswith((".exe", ".dll")) else path
        self.offset = int(load_address, 16) - IMAGE_BASE if load_address else 0
        self.ranges = [(start + self.offset, end + self.offset) for start, end in code_ranges(self.path)]

    def contains(self, address):
        return any(start <= address < end for start, end in self.ranges)


def slot_relative(address):
    return address % SLOT_SIZE if address < SLOTS_END else address


def describe(frames):
    described = []
    for frame in frames:
        function = frame.get("FunctionName") or "??"
        file_name = frame.get("FileName")
        if file_name and frame.get("Line"):
            described.append("%s %s:%d" % (function, os.path.basename(file_name.replace("\\", "/")), frame.get("Line", 0)))
        else:
            described.append(function)
    return " < ".join(described)


def symbolize(symbolizer, modules, addresses):
    names = {}
    for module in modules:
        wanted = sorted({address for address in addresses if module.contains(slot_relative(address))})
        if not wanted:
            continue
        command = [symbolizer, "--obj=%s" % module.path, "--output-style=JSON", "--adjust-vma=0x%x" % module.offset]
        result = subprocess.run(command + ["0x%x" % slot_relative(address) for address in wanted],
                                capture_output=True, text=True, check=True)
        for address, entry in zip(wanted, json.loads(result.stdout)):
            names[address] = describe(entry.get("Symbol", []))
    return names


def annotate(line, names):
    def replace(match):
        address = int(match.group(1), 16)
        if address in names:
            return "%s [%s]" % (match.group(0), names[address])
        return match.group(0)
    return ADDRESS.sub(replace, line)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Turn Windows CE addresses into functions and source lines, from the .elf beside each .exe or .dll")
    parser.add_argument("module", nargs="*", help="program.elf, or library.elf@LOADADDRESS for a DLL (hex); .exe and .dll name the .elf beside them")
    parser.add_argument("--address", "-a", action="append", default=[], help="address to look up (hex); without any, annotate stdin")
    parser.add_argument("--os", metavar="FOLDER",
                        help="OS symbol folder for a self-built image, for kernel and ROM DLL addresses")
    arguments = parser.parse_args()
    if not arguments.module and not arguments.os:
        parser.error("give at least one module, or --os")
    symbolizer = find_symbolizer()
    modules = [Module(os.path.join(arguments.os, "rom.elf"))] if arguments.os else []
    modules += [Module(specification) for specification in arguments.module]
    if arguments.address:
        addresses = [int(address, 16) for address in arguments.address]
        names = symbolize(symbolizer, modules, addresses)
        for address in addresses:
            print("%08x %s" % (address, names.get(address, "??")))
    else:
        lines = sys.stdin.readlines()
        addresses = {int(match.group(1), 16) for line in lines for match in ADDRESS.finditer(line)}
        names = symbolize(symbolizer, modules, addresses)
        for line in lines:
            sys.stdout.write(annotate(line, names))
